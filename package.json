{
  "name": "oracell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run build:shared && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "build:aggregator": "tsc -p services/aggregator/tsconfig.json",
    "predev": "npm run build:shared",
    "pretypecheck": "npm run build:shared",
    "build:sdk": "tsc -p packages/sdk/tsconfig.hosted.json",
    "build:shared": "npm run build:aggregator && npm run build:sdk"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.7.0"
  },
  "build:aggregator": "tsc -p services/aggregator/tsconfig.json",
  "prebuild": "npm run build:aggregator",
  "predev": "npm run build:aggregator",
  "pretypecheck": "npm run build:aggregator"
}
